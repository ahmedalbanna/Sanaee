rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{uid} {
      allow get: if isSignedIn() && (isOwner(uid) || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow list: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'location', 'lat', 'lng', 'geohash', 'isAvailable', 'isBarakaActive', 'voiceProfileUrl', 'craftId', 'fcmToken'])
      );
    }

    // --- Requests ---
    match /requests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Customer assigning a worker
        (resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'workerId', 'isPremium'])) ||
        // Worker confirming completion
        (resource.data.workerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'workerConfirmedCompletion']))
      );
    }

    // --- Responses ---
    match /responses/{responseId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        // Customer who owns the request or worker who sent the bid
        resource.data.workerId == request.auth.uid || 
        get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.workerId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Customer accepting/rejecting
        get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid
      );
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
    }
  }
}
