{
  "entities": {
    "User": {
      "title": "User",
      "description": "Any user of the platform (Worker or Customer).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "worker"] },
        "location": {
          "type": "object",
          "properties": {
            "city": { "type": "string" },
            "district": { "type": "string" }
          }
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "geohash": { "type": "string" },
        "rating": { "type": "number", "description": "Number of golden hammers" },
        "reviewsCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "isPremium": { "type": "boolean", "description": "For workers: Najm Al-Hara badge" },
        "voiceFingerprintId": { "type": "string", "description": "Unique voice ID for security" },
        "voiceProfileUrl": { "type": "string", "description": "Worker audio intro" },
        "craftId": { "type": "string", "description": "Specialization for workers" },
        "isBarakaActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "status"]
    },
    "Request": {
      "title": "Request",
      "description": "A service request created by a customer.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "voiceRequestUrl": { "type": "string" },
        "craftId": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "city": { "type": "string" },
            "district": { "type": "string" }
          }
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "geohash": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "assigned", "completed", "cancelled"] },
        "isPremium": { "type": "boolean", "description": "Urgent/Paid boost" },
        "urgency": { "type": "string", "enum": ["normal", "emergency"] },
        "workerId": { "type": "string", "description": "Assigned worker" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "voiceRequestUrl", "craftId", "status"]
    },
    "Response": {
      "title": "Response",
      "description": "A worker bid/response to a request.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "workerId": { "type": "string" },
        "voiceResponseUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "workerId", "voiceResponseUrl", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "An audio-visual rating for a job.",
      "type": "object",
      "properties": {
        "reviewerId": { "type": "string" },
        "revieweeId": { "type": "string" },
        "requestId": { "type": "string" },
        "rating": { "type": "number", "description": "1-5 Golden Hammers" },
        "voiceReviewUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reviewerId", "revieweeId", "requestId", "rating"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles for both customers and workers."
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Customer service requests."
    },
    "/responses/{responseId}": {
      "schema": "Response",
      "description": "Worker bids on requests."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "End-of-job reviews."
    }
  }
}
